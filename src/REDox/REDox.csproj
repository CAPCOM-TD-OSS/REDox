        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>REDox.Serialization.NewtonsoftJson</_Parameter1>
        </AssemblyAttribute>

    </ItemGroup>
</Project>
